# CineStats .gitignore

# Database (runtime-generated)
cinestats.db
cinestats.db-wal
cinestats.db-shm

# Streamlit secrets (contains TMDB API key)
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# PDF generator (utility, not part of app)
generate_pdf.py
